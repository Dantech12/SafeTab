{
  "name": "safetab",
  "version": "0.1.0",
  "private": true,
  "description": "Transparent, privacy-preserving parental-control and school device-management service (Android Enterprise pilot).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "retention": "tsx --env-file=.env src/jobs/retention.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pilot": "tsx --env-file=.env scripts/pilot.ts",
    "worker": "tsx --env-file=.env src/jobs/worker.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "google-auth-library": "^10.9.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  }
}
