# SAMPLE VALUES ONLY. Copy to .env and replace. Never commit real secrets.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Migration/owner role (owns tables, runs DDL). Used only by `npm run migrate`.
DATABASE_OWNER_URL=postgres://safetab:CHANGE_ME@localhost:5432/safetab
# Runtime role: NOT the table owner, NOBYPASSRLS, so row-level security applies.
DATABASE_URL=postgres://safetab_app:CHANGE_ME@localhost:5432/safetab

# 32+ random bytes, base64. Used to HMAC session/device tokens and enrollment codes.
TOKEN_PEPPER=REPLACE_WITH_RANDOM_BASE64

# --- Paystack (verify currency/plan availability for your Paystack country) ---
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
PAYSTACK_BASE_URL=https://api.paystack.co
BILLING_CURRENCY=USD
# Subunits (cents for USD). 500 = $5.00, 3000 = $30.00.
PLAN_INDIVIDUAL_AMOUNT=500
PLAN_ORGANIZATION_AMOUNT=3000
# Plan codes created once in Paystack (dashboard or POST /plan). Sample format only.
PAYSTACK_PLAN_INDIVIDUAL=PLN_REPLACE_ME
PAYSTACK_PLAN_ORGANIZATION=PLN_REPLACE_ME
BILLING_GRACE_DAYS=7

# --- Android Management API ---
# "fake" for local dev/tests; "amapi" to call Google's Android Management API.
MDM_PROVIDER=fake
GOOGLE_CLOUD_PROJECT_ID=
# Path to service-account JSON is read by google-auth-library via GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_APPLICATION_CREDENTIALS=
# Audience configured on the Pub/Sub push subscription (OIDC token verification).
PUBSUB_PUSH_AUDIENCE=http://localhost:3000/webhooks/amapi
PUBSUB_PUSH_SERVICE_ACCOUNT=
# Package name of the transparent student companion app (force-installed by policy).
COMPANION_APP_PACKAGE=org.example.safetab.student

# Default retention (days) for app-usage daily summaries; orgs may lower it.
DEFAULT_USAGE_RETENTION_DAYS=30
