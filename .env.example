# SAMPLE VALUES ONLY. Copy to .env and replace. Never commit real secrets.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Local-dev passwords below match docker-compose.yml; use real secrets anywhere else.
# Migration/owner role (owns tables, runs DDL). Used only by `npm run migrate`.
DATABASE_OWNER_URL=postgres://safetab:safetab_dev_only@localhost:5432/safetab
# Runtime role: NOT the table owner, NOBYPASSRLS, so row-level security applies.
DATABASE_URL=postgres://safetab_app:safetab_app_dev_only@localhost:5432/safetab

# 32+ random bytes, base64. Used to HMAC session/device tokens and enrollment codes.
TOKEN_PEPPER=REPLACE_WITH_RANDOM_BASE64

# --- Paystack (verify currency/plan availability for your Paystack country) ---
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
PAYSTACK_BASE_URL=https://api.paystack.co
# Must be a currency your Paystack account supports, and match the Paystack plans.
BILLING_CURRENCY=GHS
# Subunits (pesewas for GHS). 6000 = GH₵60.00, 24000 = GH₵240.00.
PLAN_INDIVIDUAL_AMOUNT=6000
PLAN_ORGANIZATION_AMOUNT=24000
# Optional. Leave empty: SafeTab finds or creates matching Paystack plans automatically.
PAYSTACK_PLAN_INDIVIDUAL=
PAYSTACK_PLAN_ORGANIZATION=
BILLING_GRACE_DAYS=7

# --- Android Management API ---
# "fake" for local dev/tests; "amapi" to call Google's Android Management API.
MDM_PROVIDER=fake
GOOGLE_CLOUD_PROJECT_ID=your-project-id
# Full path to the service-account key JSON, kept OUTSIDE this project folder.
# e.g. /Users/you/keys/safetab-amapi.json  or  C:\Users\you\keys\safetab-amapi.json
GOOGLE_APPLICATION_CREDENTIALS=
# "poll" (no Pub/Sub or billing needed) or "pubsub".
DEVICE_STATUS_MODE=poll
DEVICE_POLL_SECONDS=300
# Only used in pubsub mode: push subscription audience and service account.
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=
# Transparent student companion app. Keep disabled until it is published in managed
# Google Play; while disabled, downtime and usage summaries are reported as unsupported.
COMPANION_APP_PACKAGE=org.example.safetab.student
COMPANION_APP_ENABLED=false

# Default retention (days) for app-usage daily summaries; orgs may lower it.
DEFAULT_USAGE_RETENTION_DAYS=30

# --- Automatic updates (local development) ---
# `npm run dev` checks for new SafeTab changes every minute and applies them safely
# (fast-forward only; your .env and other local files are never touched).
AUTO_UPDATE=true
AUTO_UPDATE_BRANCH=claude/vibrant-pasteur-oiptqy
AUTO_UPDATE_SECONDS=60

# --- Sign in with Google / Microsoft (optional; buttons appear once set) ---
# See docs/GOING_LIVE.md for how to get these (free).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# --- Your business details (shown on the site, Terms, Privacy, Refunds, Contact) ---
BUSINESS_NAME=SafeTab
SUPPORT_EMAIL=
BUSINESS_ADDRESS=
BUSINESS_COUNTRY=Ghana

# --- Email (password reset, invitations). Easiest: run `npm run set-email`. ---
# Empty SMTP_HOST = emails are printed in the SafeTab window (local testing only).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
